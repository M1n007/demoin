{
  "name": "demoin",
  "version": "0.1.0",
  "description": "Give it a URL and a goal; an AI agent drives a real browser and renders a polished product demo video with camera moves, cursor, voiceover and subtitles.",
  "keywords": [
    "demo",
    "video",
    "screen-recording",
    "ai-agent",
    "playwright",
    "product-demo",
    "browser-automation",
    "mcp",
    "tts",
    "ffmpeg"
  ],
  "license": "MIT",
  "author": "Aminudin <amin4udin@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "demoin": "./dist/cli.js",
    "demoin-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/cases.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@napi-rs/canvas": "^1.0.10",
    "playwright-core": "^1.56.1",
    "sharp": "^0.34.5",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.32.0"
}
